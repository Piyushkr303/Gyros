# LLM
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# GitHub
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_REPOSITORY=

# Jira (optional - Requirement Agent runs in mock mode against the demo
# fixture's JIRA-142 ticket when these are unset)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Tracing (optional - Langfuse and/or LangSmith, not mutually exclusive; both
# unset falls back to a genuine no-op tracer, not a mock. Requires
# `pip install -e ".[tracing]"` in backend/ for the SDKs to be importable.)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pr-reviewer

# App
APP_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=5173
ENABLE_TEST_EXECUTION=false
DEMO_MODE=auto
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./data/reviewer.db
